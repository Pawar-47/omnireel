# OmniReel — configuration template.
# Copy to .env and fill in the keys you actually have:
#   cp .env.example .env
# .env is git-ignored and must never be committed.

# ---------------------------------------------------------------- server
OMNIREEL_HOST=127.0.0.1
OMNIREEL_PORT=8000
OMNIREEL_DATA_DIR=./data
OMNIREEL_FFMPEG=ffmpeg
OMNIREEL_FFPROBE=ffprobe

# ------------------------------------------------------------- scheduling
# How many remote generations run at the same time (2 is right for a 2-core laptop).
OMNIREEL_MAX_CONCURRENT=2
# Seconds between polling one remote job.
OMNIREEL_POLL_INTERVAL=6
# Seconds between worker passes.
OMNIREEL_WORKER_INTERVAL=3

# ---------------------------------------------------------------- safety
# Paid models are excluded unless this is explicitly turned on.
OMNIREEL_ALLOW_PAID=false
# Default generation mode: free_max | balanced | best_quality | preferred
OMNIREEL_MODE=free_max

# --------------------------------------------------------------- creative
OMNIREEL_TARGET_SECONDS=120
OMNIREEL_ASPECT_RATIO=16:9
OMNIREEL_RESOLUTION=720p

# ------------------------------------------------------------- providers
# Agnes AI (free tier, video 2.5 Flash). Get a key at https://platform.agnes-ai.com
AGNES_API_KEY=
# Optional extra keys; numbering must be contiguous (2, 3, 4 ...).
AGNES_API_KEY_2=
# Switch sites when your key was issued on the China site:
#   global: https://apihub.agnes-ai.com      (default)
#   china : https://api.agnes-ai.cn
AGNES_BASE_URL=https://apihub.agnes-ai.com

# Replicate (limited free test runs, then paid - trial fallback only)
REPLICATE_API_TOKEN=

# Hugging Face Inference Providers (pay-as-you-go / PRO credits)
HF_TOKEN=

# Runware (one-off startup credits; set the real model id in config/providers.json)
RUNWARE_API_KEY=
RUNWARE_ENDPOINT=https://api.runware.ai/v1

# YepAPI-style gateway: point these at the endpoints your account documents.
YEPAPI_API_KEY=
YEPAPI_BASE_URL=
YEPAPI_SUBMIT_PATH=/video/generations
YEPAPI_STATUS_PATH=/video/generations/{id}

# ------------------------------------------------------------ development
# Enable the offline mock provider (tests / demo runs, never real AI footage).
OMNIREEL_ENABLE_MOCK=0
# Optional extra provider overrides file.
# OMNIREEL_PROVIDERS_CONFIG=./config/providers.json

# ------------------------------------------------------------------ audio
# Optional local Piper voice model for narration (falls back to espeak-ng).
PIPER_VOICE=
