{
  "_comment": [
    "Copy this file to config/providers.json to override the built-in catalogue.",
    "Nothing here is required - OmniReel works with its documented defaults.",
    "Use it to correct a duration, add a model, or switch a provider off."
  ],

  "disable": [],

  "enable": [],

  "models": [
    {
      "_comment": "Example: pin Agnes 2.5 once you have confirmed its clip lengths in the console.",
      "provider": "agnes",
      "model": "agnes-video-2.5",
      "label": "Agnes Video 2.5",
      "durations": [5, 10, 15, 20],
      "resolutions": ["720p"],
      "aspect_ratios": ["16:9", "9:16", "1:1"],
      "text_to_video": true,
      "image_to_video": true,
      "reference_frame": true,
      "quality": 4,
      "speed": 2,
      "free_kind": "promo",
      "daily_free_requests": null,
      "min_interval_seconds": 4,
      "enabled": false,
      "docs_url": "https://wiki.agnes-ai.com/en/docs/overview",
      "notes": "Unverified duration set - confirm before enabling."
    },
    {
      "_comment": "Example: your Runware account's real video model id.",
      "provider": "runware",
      "model": "video-default",
      "label": "Runware video",
      "durations": [5, 10],
      "resolutions": ["720p"],
      "aspect_ratios": ["16:9", "9:16"],
      "free_kind": "trial",
      "enabled": false,
      "notes": "One-off startup credits only."
    },
    {
      "_comment": [
        "Example: promote a paid aggregator model once you have decided to spend.",
        "This only matters when OMNIREEL_ALLOW_PAID=true - free_max never selects it.",
        "Refresh the whole set instead of editing by hand:",
        "  .venv/bin/python scripts/discover_models.py --write"
      ],
      "provider": "pollinations",
      "model": "alibaba/wan-2.6",
      "label": "WAN 2.6 (15 s)",
      "durations": [5, 10, 15],
      "resolutions": ["720p"],
      "aspect_ratios": ["16:9", "9:16"],
      "free_kind": "none",
      "enabled": false,
      "notes": "The only 15 s clip available; paid."
    },
    {
      "_comment": "Example: pin the real clip length once BigModel tells you what cogvideox-flash returns.",
      "provider": "bigmodel",
      "model": "cogvideox-flash",
      "durations": [5],
      "free_kind": "recurring",
      "enabled": true,
      "notes": "Edit durations here if your account returns a different clip length."
    }
  ]
}
